<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_alwabrn" model="ir.module.category">
        <field name="name">نظام الوبران للمستودعات</field>
        <field name="sequence">5</field>
    </record>
    <record id="privilege_alwabrn" model="res.groups.privilege">
        <field name="name">نظام الوبران</field>
        <field name="category_id" ref="module_category_alwabrn"/>
    </record>
    <record id="group_alw_auditor" model="res.groups">
        <field name="name">مدقق (قراءة فقط)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_alwabrn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_alw_supervisor" model="res.groups">
        <field name="name">مشرف مشروع</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_alwabrn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_alw_employee" model="res.groups">
        <field name="name">موظف مستودع</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_alwabrn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_alw_manager" model="res.groups">
        <field name="name">مدير المستودع</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_alwabrn"/>
        <field name="implied_ids" eval="[(4, ref('group_alw_employee')), (4, ref('group_alw_auditor'))]"/>
    </record>
    <record id="group_alw_admin" model="res.groups">
        <field name="name">مدير النظام</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_alwabrn"/>
        <field name="implied_ids" eval="[(4, ref('group_alw_manager')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Project supervisor: only own sites and their custody / movements -->
    <record id="rule_site_supervisor" model="ir.rule">
        <field name="name">المشرف: مواقعه فقط</field>
        <field name="model_id" ref="model_alwabrn_site"/>
        <field name="groups" eval="[(4, ref('group_alw_supervisor'))]"/>
        <field name="domain_force">[('supervisor_id', '=', user.id)]</field>
    </record>
    <record id="rule_site_all" model="ir.rule">
        <field name="name">الموظف/المدقق: كل المواقع</field>
        <field name="model_id" ref="model_alwabrn_site"/>
        <field name="groups" eval="[(4, ref('group_alw_employee')), (4, ref('group_alw_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_custody_supervisor" model="ir.rule">
        <field name="name">المشرف: عهد مواقعه فقط</field>
        <field name="model_id" ref="model_alwabrn_custody_line"/>
        <field name="groups" eval="[(4, ref('group_alw_supervisor'))]"/>
        <field name="domain_force">[('supervisor_id', '=', user.id)]</field>
    </record>
    <record id="rule_custody_all" model="ir.rule">
        <field name="name">الموظف/المدقق: كل العهد</field>
        <field name="model_id" ref="model_alwabrn_custody_line"/>
        <field name="groups" eval="[(4, ref('group_alw_employee')), (4, ref('group_alw_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_tx_supervisor" model="ir.rule">
        <field name="name">المشرف: حركات مواقعه فقط</field>
        <field name="model_id" ref="model_alwabrn_transaction"/>
        <field name="groups" eval="[(4, ref('group_alw_supervisor'))]"/>
        <field name="domain_force">[('site_id.supervisor_id', '=', user.id)]</field>
    </record>
    <record id="rule_tx_all" model="ir.rule">
        <field name="name">الموظف/المدقق: كل الحركات</field>
        <field name="model_id" ref="model_alwabrn_transaction"/>
        <field name="groups" eval="[(4, ref('group_alw_employee')), (4, ref('group_alw_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_txline_supervisor" model="ir.rule">
        <field name="name">المشرف: بنود حركات مواقعه فقط</field>
        <field name="model_id" ref="model_alwabrn_transaction_line"/>
        <field name="groups" eval="[(4, ref('group_alw_supervisor'))]"/>
        <field name="domain_force">[('site_id.supervisor_id', '=', user.id)]</field>
    </record>
    <record id="rule_txline_all" model="ir.rule">
        <field name="name">الموظف/المدقق: كل البنود</field>
        <field name="model_id" ref="model_alwabrn_transaction_line"/>
        <field name="groups" eval="[(4, ref('group_alw_employee')), (4, ref('group_alw_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
