<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_list" model="ir.ui.view">
        <field name="name">alwabrn.import.batch.list</field>
        <field name="model">alwabrn.import.batch</field>
        <field name="arch" type="xml">
            <list string="دفعات الإدخال" decoration-warning="state == 'needs_review'" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/><field name="create_date" string="تاريخ الإدخال"/><field name="channel"/>
                <field name="content_type"/><field name="effective_date"/><field name="subject" optional="show"/>
                <field name="sender" optional="show"/><field name="line_count"/><field name="error_count"/>
                <field name="warning_count"/><field name="submitted_by" optional="show"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'posted')"
                       decoration-warning="state == 'needs_review'" decoration-danger="state in ('failed', 'rejected')"/>
            </list>
        </field>
    </record>
    <record id="view_batch_form" model="ir.ui.view">
        <field name="name">alwabrn.import.batch.form</field>
        <field name="model">alwabrn.import.batch</field>
        <field name="arch" type="xml">
            <form string="دفعة إدخال">
                <header>
                    <button name="action_validate" type="object" string="تحقق من البيانات" class="btn-primary"
                            invisible="state in ('approved', 'posted', 'rejected')"/>
                    <button name="action_approve" type="object" string="اعتماد" class="btn-success"
                            invisible="state not in ('needs_review', 'validated')" groups="alwabrn_warehouse.group_alw_manager"
                            confirm="أنواع الحركات تُرحّل إلى مخزون Odoo. الأرصدة الدفترية والجرد تُحفظ ككشف فقط دون تغيير المخزون. متابعة؟"/>
                    <button name="action_reject" type="object" string="رفض" invisible="state in ('approved', 'posted', 'rejected')"
                            groups="alwabrn_warehouse.group_alw_manager"/>
                    <button name="action_reset" type="object" string="إعادة لمسودة" invisible="state not in ('rejected', 'failed')"/>
                    <button name="action_download_validation_report" type="object" string="تنزيل تقرير التحقق (Excel)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,needs_review,validated,approved,posted"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="content_type != 'unknown' or state in ('approved', 'posted')">
                        نوع البيانات غير مصنف. النظام لا يفترض أن الكميات «استلام». اختر النوع الصحيح قبل الاعتماد.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not duplicate_of_id">
                        تكرار محتمل: نفس الملف/المحتوى سبق اعتماده في <field name="duplicate_of_id" readonly="1" nolabel="1"/>.
                        لن يُرحّل إلا إذا أكد المدير أنه ليس مكرراً.
                        <field name="allow_duplicate" groups="alwabrn_warehouse.group_alw_manager"/> ليست مكررة
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="channel" readonly="1"/>
                            <field name="content_type" readonly="state in ('approved', 'posted')"/>
                            <field name="effective_date" readonly="state in ('approved', 'posted')"/>
                            <field name="site_id" readonly="state in ('approved', 'posted')"/>
                            <field name="location_id" readonly="state in ('approved', 'posted')" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="subject"/><field name="document_ref"/><field name="sender" invisible="not sender"/>
                            <field name="submitted_by"/><field name="approved_by" invisible="not approved_by"/>
                            <field name="line_count"/><field name="error_count"/><field name="warning_count"/>
                        </group>
                    </group>
                    <div class="row">
                        <div class="col-lg-4" invisible="not preview_image">
                            <h4>المستند الأصلي</h4>
                            <field name="preview_image" widget="image" readonly="1" options="{'zoom': true}" class="alw_doc_image"/>
                        </div>
                        <div class="col">
                            <h4>الأسطر المستخرجة (قابلة للتصحيح قبل الاعتماد)</h4>
                            <field name="line_ids" readonly="state in ('approved', 'posted', 'rejected')">
                                <list editable="bottom" decoration-danger="status == 'error'" decoration-warning="status == 'warning'"
                                      decoration-muted="excluded">
                                    <field name="line_no"/>
                                    <field name="raw_text" optional="show" readonly="1"/>
                                    <field name="sec_code"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="unit_text" optional="hide"/>
                                    <field name="uom_id" options="{'no_create': True}"/>
                                    <field name="qty_product_uom" optional="show"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="line_date" optional="show"/>
                                    <field name="site_ref" optional="hide"/>
                                    <field name="site_id" optional="show"/>
                                    <field name="confidence" optional="show"/>
                                    <field name="status" widget="badge" decoration-success="status == 'ok'"
                                           decoration-warning="status == 'warning'" decoration-danger="status == 'error'"/>
                                    <field name="issue_text"/>
                                    <field name="reviewed" widget="boolean_toggle"/>
                                    <field name="excluded" widget="boolean_toggle"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <notebook>
                        <page string="المستندات المصدر">
                            <field name="source_document_ids" readonly="1">
                                <list>
                                    <field name="name"/><field name="channel"/><field name="register_type"/>
                                    <field name="mimetype"/><field name="file_size"/><field name="file_hash"/>
                                    <field name="duplicate_of_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="النص الأصلي"><field name="raw_text" readonly="1"/></page>
                        <page string="النتائج">
                            <group>
                                <field name="transaction_ids" readonly="1" widget="many2many_tags"/>
                                <field name="snapshot_ids" readonly="1" widget="many2many_tags"/>
                                <field name="external_message_id"/><field name="content_hash"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_batch_search" model="ir.ui.view">
        <field name="name">alwabrn.import.batch.search</field>
        <field name="model">alwabrn.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('subject', 'ilike', self), ('line_ids.sec_code', 'ilike', self)]"/>
                <field name="sender"/>
                <filter name="todo" string="قيد المراجعة" domain="[('state', 'in', ('draft', 'needs_review', 'validated'))]"/>
                <filter name="wa" string="واتساب" domain="[('channel', '=', 'whatsapp')]"/>
                <filter name="mail" string="بريد" domain="[('channel', '=', 'email')]"/>
                <filter name="ocr" string="صور / كاميرا / PDF" domain="[('channel', 'in', ('camera', 'image', 'pdf'))]"/>
                <group>
                    <filter name="g_channel" string="القناة" context="{'group_by': 'channel'}"/>
                    <filter name="g_type" string="نوع البيانات" context="{'group_by': 'content_type'}"/>
                    <filter name="g_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_batches" model="ir.actions.act_window">
        <field name="name">الإدخال الذكي — دفعات المراجعة</field>
        <field name="res_model">alwabrn.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>
    <record id="action_batches_ocr" model="ir.actions.act_window">
        <field name="name">تصوير الدفاتر — الدفعات</field>
        <field name="res_model">alwabrn.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_ocr': 1}</field>
    </record>
    <record id="action_batches_external" model="ir.actions.act_window">
        <field name="name">رسائل واتساب والبريد الواردة</field>
        <field name="res_model">alwabrn.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel', 'in', ('whatsapp', 'email'))]</field>
    </record>

    <record id="view_document_list" model="ir.ui.view">
        <field name="name">alwabrn.source.document.list</field>
        <field name="model">alwabrn.source.document</field>
        <field name="arch" type="xml">
            <list string="المستندات المصدر" create="0">
                <field name="name"/><field name="create_date"/><field name="channel"/><field name="register_type"/>
                <field name="uploaded_by"/><field name="batch_id"/><field name="file_hash" optional="hide"/>
                <field name="duplicate_of_id"/>
            </list>
        </field>
    </record>
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">alwabrn.source.document.form</field>
        <field name="model">alwabrn.source.document</field>
        <field name="arch" type="xml">
            <form string="مستند مصدر" create="0">
                <header><button name="action_run_ocr" type="object" string="إعادة تشغيل OCR" groups="alwabrn_warehouse.group_alw_employee"/></header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="channel"/><field name="register_type"/><field name="batch_id"/></group>
                        <group><field name="mimetype"/><field name="file_size"/><field name="file_hash"/>
                            <field name="duplicate_of_id"/><field name="uploaded_by"/><field name="external_ref"/></group>
                    </group>
                    <field name="is_image" invisible="1"/>
                    <field name="datas" widget="image" invisible="not is_image" readonly="1"/>
                    <field name="datas" filename="name" invisible="is_image" readonly="1"/>
                    <field name="extraction_ids" readonly="1">
                        <list><field name="create_date"/><field name="provider"/><field name="page"/><field name="state"/>
                            <field name="confidence"/><field name="error"/></list>
                        <form><group><field name="provider"/><field name="state"/><field name="confidence"/><field name="error"/></group>
                            <field name="raw_text"/></form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_documents" model="ir.actions.act_window">
        <field name="name">أرشيف المستندات المصدر</field>
        <field name="res_model">alwabrn.source.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
