<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_snapshot_list" model="ir.ui.view">
        <field name="name">alwabrn.daily.snapshot.list</field>
        <field name="model">alwabrn.daily.snapshot</field>
        <field name="arch" type="xml">
            <list string="كشوف الرصيد اليومي">
                <field name="name"/><field name="balance_date"/><field name="snapshot_type"/><field name="location_id"/>
                <field name="line_count"/><field name="submitted_by"/><field name="batch_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_snapshot_form" model="ir.ui.view">
        <field name="name">alwabrn.daily.snapshot.form</field>
        <field name="model">alwabrn.daily.snapshot</field>
        <field name="arch" type="xml">
            <form string="إدخال الرصيد اليومي">
                <header>
                    <button name="action_approve" type="object" string="اعتماد الكشف" class="btn-primary" invisible="state != 'draft'"
                            groups="alwabrn_warehouse.group_alw_manager"/>
                    <button name="action_reconcile" type="object" string="مطابقة مع رصيد Odoo" class="btn-success" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state == 'cancelled'" groups="alwabrn_warehouse.group_alw_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        كشف الرصيد ليس استلاماً: حفظه واعتماده <b>لا يغير</b> أرصدة Odoo الرسمية. يستخدم للمطابقة فقط.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="snapshot_type" readonly="state != 'draft'"/>
                            <field name="balance_date" readonly="state != 'draft'"/>
                            <field name="cutoff" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="submitted_by"/><field name="batch_id"/>
                            <field name="source_document_ids" widget="many2many_tags"/><field name="note"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" options="{'no_create': True}" placeholder="ابحث بكود SEC أو الوصف"/>
                            <field name="sec_code"/><field name="quantity"/><field name="uom_id" options="{'no_create': True}"/>
                            <field name="qty_product_uom"/><field name="product_uom_id"/><field name="note"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_snapshot_search" model="ir.ui.view">
        <field name="name">alwabrn.daily.snapshot.search</field>
        <field name="model">alwabrn.daily.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="book" string="رصيد دفتري" domain="[('snapshot_type', '=', 'book')]"/>
                <filter name="physical" string="جرد فعلي" domain="[('snapshot_type', '=', 'physical')]"/>
                <filter name="draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="date" string="التاريخ" date="balance_date"/>
            </search>
        </field>
    </record>
    <record id="action_snapshots" model="ir.actions.act_window">
        <field name="name">إدخال الرصيد اليومي</field>
        <field name="res_model">alwabrn.daily.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_snapshot_new" model="ir.actions.act_window">
        <field name="name">إدخال رصيد يومي</field>
        <field name="res_model">alwabrn.daily.snapshot</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
