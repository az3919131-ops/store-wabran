<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_history_list" model="ir.ui.view">
        <field name="name">alwabrn.report.history.list</field>
        <field name="model">alwabrn.report.history</field>
        <field name="arch" type="xml">
            <list string="سجل التقارير" create="0">
                <field name="create_date" string="التوقيت"/><field name="name"/><field name="date_from"/><field name="date_to"/>
                <field name="action"/><field name="user_id"/><field name="recipients"/>
                <field name="delivery_state" widget="badge" decoration-success="delivery_state == 'sent'" decoration-danger="delivery_state == 'failed'"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_report_history_form" model="ir.ui.view">
        <field name="name">alwabrn.report.history.form</field>
        <field name="model">alwabrn.report.history</field>
        <field name="arch" type="xml">
            <form string="تقرير مصدّر" create="0" edit="0">
                <header><button name="action_refresh_delivery" type="object" string="تحديث حالة التسليم"/></header>
                <sheet><group>
                    <field name="name"/><field name="date_from"/><field name="date_to"/><field name="filters_text"/>
                    <field name="action"/><field name="user_id"/><field name="recipients"/><field name="delivery_state"/>
                    <field name="error"/><field name="attachment_ids" widget="many2many_binary"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_report_history" model="ir.actions.act_window">
        <field name="name">سجل التقارير المصدرة والمرسلة</field>
        <field name="res_model">alwabrn.report.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_schedule_list" model="ir.ui.view">
        <field name="name">alwabrn.report.schedule.list</field>
        <field name="model">alwabrn.report.schedule</field>
        <field name="arch" type="xml">
            <list string="التقارير المجدولة">
                <field name="name"/><field name="report_code"/><field name="frequency"/><field name="hour"/>
                <field name="file_format"/><field name="recipient_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/><field name="last_run_on"/>
            </list>
        </field>
    </record>
    <record id="view_schedule_form" model="ir.ui.view">
        <field name="name">alwabrn.report.schedule.form</field>
        <field name="model">alwabrn.report.schedule</field>
        <field name="arch" type="xml">
            <form string="تقرير مجدول">
                <sheet>
                    <div class="alert alert-warning" role="alert">الإرسال المجدول لا يعمل إلا بعد تفعيله من مدير النظام، وللمستلمين المحددين فقط.</div>
                    <group>
                        <group>
                            <field name="name"/><field name="report_code"/><field name="frequency"/><field name="hour"/>
                            <field name="weekday" invisible="frequency != 'weekly'"/><field name="monthday" invisible="frequency != 'monthly'"/>
                            <field name="file_format"/><field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="recipient_ids" widget="many2many_tags"/><field name="site_id"/><field name="project_id"/>
                            <field name="categ_id"/><field name="last_run_key"/><field name="last_run_on"/>
                        </group>
                    </group>
                    <field name="history_ids" readonly="1"><list><field name="create_date"/><field name="recipients"/><field name="delivery_state"/><field name="error"/></list></field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_schedules" model="ir.actions.act_window">
        <field name="name">التقارير المجدولة</field>
        <field name="res_model">alwabrn.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="view_approval_list" model="ir.ui.view">
        <field name="name">alwabrn.approval.list</field>
        <field name="model">alwabrn.approval</field>
        <field name="arch" type="xml">
            <list string="سجل التدقيق" create="0" edit="0" delete="0">
                <field name="date"/><field name="user_id"/><field name="action" widget="badge"/><field name="name"/>
                <field name="res_model" optional="show"/><field name="note"/><field name="details" optional="show"/>
                <button name="action_open_record" type="object" string="فتح" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="view_approval_search" model="ir.ui.view">
        <field name="name">alwabrn.approval.search</field>
        <field name="model">alwabrn.approval</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="user_id"/>
                <filter name="date" string="التاريخ" date="date"/>
                <group><filter name="g_action" string="الإجراء" context="{'group_by': 'action'}"/>
                    <filter name="g_user" string="المستخدم" context="{'group_by': 'user_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_approvals" model="ir.actions.act_window">
        <field name="name">سجل التدقيق والاعتمادات</field>
        <field name="res_model">alwabrn.approval</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
