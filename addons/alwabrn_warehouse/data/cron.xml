<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_scheduled_reports" model="ir.cron">
        <field name="name">الوبران: التقارير المجدولة</field>
        <field name="model_id" ref="model_alwabrn_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model.cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_whatsapp_summary" model="ir.cron">
        <field name="name">الوبران: ملخص واتساب اليومي (يتطلب تفعيل المدير)</field>
        <field name="model_id" ref="model_alwabrn_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model.cron_notify()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
