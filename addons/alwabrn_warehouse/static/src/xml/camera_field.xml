<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alwabrn_warehouse.CameraField">
        <div class="alw_camera_field">
            <button type="button" class="btn btn-primary btn-lg" t-on-click="open" t-att-disabled="props.readonly">
                <i class="fa fa-camera me-2"/>فتح الكاميرا والتقاط صورة
            </button>
            <input type="file" accept="image/*" capture="environment" class="d-none" t-ref="input" t-on-change="onChange"/>
            <div t-if="state.preview" class="mt-2">
                <img t-att-src="state.preview" style="max-width:100%;max-height:280px;border-radius:8px"/>
                <div class="text-muted small" t-out="state.name"/>
            </div>
        </div>
    </t>
</templates>
